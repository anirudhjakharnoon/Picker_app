# Supabase project connection info.
#
# These two values are PUBLIC by design: the anon/publishable key only grants
# whatever Row Level Security policies allow, so it is safe to ship inside the
# built PWA. Never put the Supabase *service role* key in a VITE_ variable —
# anything prefixed VITE_ is bundled into client-side JavaScript and visible
# to anyone who opens the app.
#
# Get the anon/publishable key from: Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://jptcwfxioelgedgfduzk.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-anon-public-key
