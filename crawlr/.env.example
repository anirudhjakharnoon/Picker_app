# Public - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only - NEVER exposed to the client, NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build the crawler's User-Agent string and canonical /about-crawlr link
NEXT_PUBLIC_SITE_URL=https://crawlr.example.com

# Vercel Cron shared secret - set the same value in Vercel project env vars
# and as the Authorization bearer token cron requests must present.
CRON_SECRET=change-me-to-a-long-random-string
